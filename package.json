{
  "name": "ast-navigator-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that lets LLMs explore the Abstract Syntax Tree of local JavaScript/TypeScript repositories using Tree-sitter.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ast-navigator-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run build && node --test --test-timeout=60000 test/*.test.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "tree-sitter": "$tree-sitter",
    "tree-sitter-javascript": "$tree-sitter-javascript"
  }
}
